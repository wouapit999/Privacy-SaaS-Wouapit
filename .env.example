# ─────────────────────────────────────────────────────────────
# Privacy Presence Manager — environment configuration
# Copy to .env. Local defaults work without any real provider keys.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=ppm
POSTGRES_PASSWORD=ppm_local_password
POSTGRES_DB=ppm
# Used by the API (host is 'postgres' inside docker-compose, 'localhost' otherwise)
DATABASE_URL=postgresql://ppm:ppm_local_password@localhost:5432/ppm?schema=public

# ── Redis / BullMQ ────────────────────────────────────────────
# Local/docker: use discrete host/port. Managed Redis (Railway/Upstash):
# set REDIS_URL instead (takes precedence; rediss:// enables TLS, and any
# password in the URL is used automatically).
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=rediss://default:password@host:6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ── API ───────────────────────────────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Secrets (CHANGE IN PRODUCTION) ────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=1209600     # 14 days
# 32-byte base64 key for AES-256-GCM field encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktY2hhbmdlbWUhISE=

# ── OAuth providers (leave client id/secret blank to disable) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Public base URL the providers redirect back to. Register the callback
#   <OAUTH_CALLBACK_BASE>/auth/oauth/google/callback
#   <OAUTH_CALLBACK_BASE>/auth/oauth/microsoft/callback
# in each provider's console. Must be publicly reachable (or a tunnel) in prod.
OAUTH_CALLBACK_BASE=http://localhost:4000
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/oauth/callback
OAUTH_STATE_SECRET=dev-oauth-state-secret-change-me

# ── Social API connectors (stubs — leave blank to disable) ────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── AI (OpenAI-compatible provider — stub returns canned output) ─
AI_PROVIDER=stub                 # 'stub' | 'openai'
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# ── Discovery engine ──────────────────────────────────────────
DISCOVERY_USER_AGENT=PrivacyPresenceManagerBot/0.1 (+https://example.com/bot)
DISCOVERY_RESPECT_ROBOTS=true    # MUST stay true; hard-enforced in code
DISCOVERY_MAX_PAGES_PER_SCAN=50

# ── Email notifications (stub logs to console) ────────────────
MAIL_PROVIDER=stub               # 'stub' | 'smtp' | 'resend'
MAIL_FROM=Privacy Presence Manager <noreply@example.com>
MAIL_API_KEY=

# ── Scheduled monitoring (BullMQ repeatable jobs) ─────────────
MONITORING_ENABLED=true          # set false to skip registering schedulers (tests/CI)
MONITORING_DAILY_CRON=0 3 * * *      # daily identity re-scan
MONITORING_WEEKLY_CRON=0 4 * * 1     # weekly report (Mondays)
MONITORING_MONTHLY_CRON=0 5 1 * *    # monthly report (1st of month)

# ── Web (Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
